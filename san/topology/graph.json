{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "sanBlueprintEdition": "3.7",
  "graphKind": "hybrid",
  "authoritative": true,
  "nodeBudgetPolicy": {
    "targetMaxNodeLoadPercent": 5,
    "reviewTriggerPercent": 5,
    "mandatoryDispersionReviewPercent": 10,
    "allowExceptionalNodes": true,
    "notes": "Effective load is weighted structural burden, not raw LOC alone."
  },
  "factors": [
    "codeSurfaceShare",
    "dependencyCentrality",
    "fanInFanOutPressure",
    "affectedRadius",
    "changeFrequency",
    "runtimeCriticality",
    "verificationSpan",
    "hiddenStateRisk"
  ],
  "agentOrientation": {
    "canonicalDoctrineSurface": "AGENTS.md",
    "canonicalControlPlaneSurface": "san/control-plane.md",
    "canonicalDurableStateSurface": "san/state/durable-state.md",
    "canonicalPreflightSurface": "san/preflight.md",
    "canonicalSanlockSurface": "san/sanlock.md",
    "defaultColdStartSequence": [
      "Read AGENTS.md",
      "Read san/control-plane.md",
      "Read san/state/durable-state.md",
      "Read san/preflight.md",
      "Read san/topology/graph.json",
      "Read san/sanlock.md"
    ],
    "defaultExecutionEntrypoints": [
      "npm run dev",
      "npm run db:setup"
    ],
    "defaultVerificationEntrypoints": [
      "npm run lint",
      "npm run typecheck",
      "npm run test",
      "npm run test:e2e",
      "npm run san:preflight",
      "npm run san:lock",
      "npm run san:graph:validate",
      "npm run evidence:catalog",
      "npm run evidence:full",
      "npm run verify:accountable"
    ],
    "notes": "CMEP v1 is a local-first multi-tenant product shell with tenant-scoped repositories, accountable observability, and Oracle-ready evidence packaging."
  },
